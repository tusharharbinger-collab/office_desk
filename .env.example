# ==============================================================================
# SmartDesk Workplace Booking - Free Microsoft Organization SSO Configuration
# ==============================================================================
# Microsoft Entra ID (formerly Azure Active Directory) Free Edition provides 
# 100% Free OAuth 2.0 / OpenID Connect Single Sign-On for your organization.
#
# Free Setup Instructions:
# 1. Sign in to https://portal.azure.com (or https://entra.microsoft.com)
# 2. Navigate to "Microsoft Entra ID" -> "App registrations" -> "New registration"
# 3. Enter App Name: "SmartDesk Workplace Booking"
# 4. Supported account types:
#    - "Accounts in this organizational directory only" (Single Tenant for your company domain)
# 5. Redirect URI:
#    - Platform: Web
#    - URI: http://localhost:5173
# 6. Copy the Application (Client) ID and Directory (Tenant) ID below:

MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173

# Server Settings
PORT=5180
JWT_SECRET=smartdesk_super_secret_jwt_key_2026
